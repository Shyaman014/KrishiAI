# =============================================
# AI Service Environment Variables
# =============================================
# Copy this file to .env and fill in your values.

# ---- Service ----
APP_ENV=development
APP_PORT=8000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# ---- Express Server (for inter-service calls) ----
SERVER_URL=http://localhost:5000

