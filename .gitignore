# =============================================
# KrishiAI – Root .gitignore
# =============================================

# ---- Environment Variables ----
.env
.env.local
.env.*.local
!.env.example

# ---- Node.js / npm ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ---- Build Outputs ----
dist/
build/
out/
.next/
.nuxt/

# ---- TypeScript ----
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
*.egg
.Python
pip-log.txt
pip-delete-this-directory.txt

# ---- FastAPI / Uvicorn ----
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ---- Logs ----
logs/
*.log
server/logs/

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- IDE / Editor ----
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Misc ----
.cache/
.parcel-cache/
*.temp
*.tmp
